

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: #241638;
    font-family: Georgia, serif;
    color: #F3D78B;
}

.game-info {
    position: absolute;
    top: 15px;
    left: 20px;
    right: 20px;
    z-index: 2;

    display: flex;
    justify-content: space-between;
    align-items: center;

    text-shadow: 0 0 10px #B78AE0;
}

h1 {
    font-size: 24px;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: #285B42;
}

.instructions {
    position: absolute;
    bottom: 15px;
    left: 20px;
    z-index: 2;
    font-size: 14px;
    text-shadow: 0 0 10px #B78AE0;
}

