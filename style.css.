
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    background: #241638;
    color: #F3D78B;
    font-family: Georgia, serif;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.game-container {
    width: 100%;
    max-width: none;
    min-height: 100vh;
    padding: 20px;
    text-align: center;
    background: #542D78;
    border: 3px solid #F3D78B;
    border-radius: 18px;
    box-shadow: 0 0 30px #B78AE0;
}

h1 {
    font-size: clamp(24px, 5vw, 42px);
    margin-bottom: 20px;
    letter-spacing: 3px;
    color: #F3D78B;
}

.game-info {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    font-size: 15px;
}

canvas {
    display: block;
    width: 100%;
    height: auto;
    border: 3px solid #F3D78B;
    border-radius: 10px;
    background: #285B42;
}

.instructions {
    margin-top: 15px;
    color: #F3D78B;
    font-size: 15px;
}

@media (max-width: 500px) {
    .game-container {
        padding: 12px;
    }

    .game-info {
        font-size: 12px;
    }
}

