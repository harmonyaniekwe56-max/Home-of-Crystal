
/* HOME OF CRYSTAL
   Royal Fantasy Theme
*/

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    background: #241638;
    color: #F3D78B;
    font-family: Georgia, serif;
    display: flex;
    justify-content: center;
    align-items: center;
}

.game-container {
    width: 90%;
    max-width: 800px;
    min-height: 450px;
    padding: 50px 20px;
    text-align: center;

    background: linear-gradient(
        145deg,
        #542D78,
        #241638
    );

    border: 3px solid #F3D78B;
    border-radius: 20px;

    box-shadow: 0 0 30px #B78AE0;
}

h1 {
    font-size: clamp(2rem, 7vw, 3.5rem);
    letter-spacing: 5px;
    margin-bottom: 20px;
    color: #F3D78B;
    text-shadow: 0 0 15px #B78AE0;
}

.subtitle {
    color: #E5CCFF;
    font-size: 18px;
    margin-bottom: 40px;
}

button {
    padding: 16px 40px;
    background: #F3D78B;
    color: #241638;
    border: none;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #B78AE0;
    transform: scale(1.05);
    box-shadow: 0 0 20px #F3D78B;
}
